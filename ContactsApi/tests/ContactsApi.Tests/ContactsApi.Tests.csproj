<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The web projects bring ASP.NET Core 9; run on the next major where only that is installed -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The operator's role script: the isolation tests run the same file (AD-49 rule 9) -->
    <None Include="../../../helm/contacts/files/db-roles.sql" Link="Rls/db-roles.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ContactsApi.Infrastructure\ContactsApi.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\EchoRoutes.Worker\EchoRoutes.Worker.csproj" />
    <ProjectReference Include="..\..\src\ContactsApi.WebApi\ContactsApi.WebApi.csproj" />
  </ItemGroup>

</Project>