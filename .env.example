# ===================================
# Contacts Application - Environment Variables
# ===================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

# ===================================
# Google OAuth Configuration
# ===================================
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Make sure to configure:
# - Authorized redirect URIs: http://localhost:5000/api/auth/callback
# - Authorized JavaScript origins: http://localhost:3002
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Backend API base URL (for Docker deployment)
REACT_APP_API_BASE_URL=http://localhost:5000/api

# ===================================
# Database Configuration (PostgreSQL)
# ===================================
# PostgreSQL credentials
POSTGRES_USER=contactsapi
POSTGRES_PASSWORD=
POSTGRES_DB=contactsdb

# ===================================
# Local Vault (dev mode) and sign-in
# ===================================
# Root token of the throwaway dev-mode Vault in docker-compose (any random string;
# generate one with: openssl rand -hex 24). Never a real Vault token.
VAULT_DEV_ROOT_TOKEN=
# Who may sign in (comma separated, verified Google addresses). Empty = nobody.
ECHO_ALLOWED_EMAILS=

# Running the backend with `dotnet run` instead of compose: keep local secrets in
# user-secrets, not appsettings.json, e.g. from ContactsApi/src/ContactsApi.WebApi:
#   dotnet user-secrets set "Database:ConnectionString" "Host=localhost;Port=5432;Database=contactsdb;Username=contactsapi;Password=<yours>"
#   dotnet user-secrets set "Vault:Token" "<your dev Vault token>"
#   dotnet user-secrets set "Echo:AllowedEmails" "you@example.com"

# ===================================
# Environment
# ===================================
NODE_ENV=production
